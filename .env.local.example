NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Regatta CR (proyecto Supabase separado) — solo para "Canchas de regata".
NEXT_PUBLIC_REGATTA_SUPABASE_URL=
NEXT_PUBLIC_REGATTA_SUPABASE_ANON_KEY=

# URL pública del apps/web de Coach Data — link "Pagar ahora" del evento
# y puente del checkout de Coach Data Pro (api/checkout/coachdata).
NEXT_PUBLIC_COACH_DATA_WEB_URL=

# URL pública de este sitio — back_url del checkout de Regatta RC Pro.
NEXT_PUBLIC_SITE_URL=https://analytics.kalai.com.ar

# Mercado Pago — MISMA cuenta/Access Token que ya usa apps/web de Coach
# Data (decisión del usuario 2026-08-19). El secreto de webhook es
# PROPIO: Mercado Pago entrega uno distinto por cada URL de webhook
# registrada, no reusar el de Coach Data.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_REGATTARC_WEBHOOK_SECRET=

# service_role del proyecto Supabase de Regatta RC (cpcjljvdhotrtlflbdbd)
# — solo la usa api/webhooks/regattarc-mercadopago para escribir
# `subscriptions` (esa tabla no tiene policy de INSERT/UPDATE para el
# cliente). Nunca exponer con prefijo NEXT_PUBLIC_.
REGATTA_CR_SUPABASE_SERVICE_ROLE_KEY=
