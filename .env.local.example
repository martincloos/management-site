NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Regatta CR (proyecto Supabase separado) — solo para "Canchas de regata".
NEXT_PUBLIC_REGATTA_SUPABASE_URL=
NEXT_PUBLIC_REGATTA_SUPABASE_ANON_KEY=

# URL pública del apps/web de Coach Data — link "Pagar ahora" del evento
# y puente del checkout de Coach Data Pro (api/checkout/coachdata).
NEXT_PUBLIC_COACH_DATA_WEB_URL=

# URL pública de este sitio — back_url del checkout de Regatta RC Pro.
NEXT_PUBLIC_SITE_URL=https://analytics.kalai.com.ar

# Mercado Pago — MISMA cuenta/Access Token que ya usa apps/web de Coach
# Data (decisión del usuario 2026-08-19). Solo para CREAR el pago
# (api/checkout/regattarc) — el webhook que lo confirma vive en el
# proyecto de Regatta CR (supabase/functions/regattarc-mercadopago-webhook
# de regatta-cr, con su propio secreto de firma ahí), nunca acá, para que
# la service_role de esa base nunca salga de su propio proyecto.
MERCADOPAGO_ACCESS_TOKEN=
